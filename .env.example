# 讯飞语音听写（IAT）配置 —— 复制本文件为 .env 并填入真实值
# 注意：.env 已被 .gitignore 忽略，不会提交到 Git
VITE_XF_APPID=your_app_id
VITE_XF_APIKEY=your_api_key
VITE_XF_APISECRET=your_api_secret

# 数据库直连（后端专用）
DATABASE_URL=postgresql://postgres:password@db.your_ref.supabase.co:5432/postgres

# Supabase 排行榜
# publishable 公钥：前端 REST API 使用
VITE_SUPABASE_URL=https://your_ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
# secret 密钥：仅服务端使用，绝不放入前端
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
